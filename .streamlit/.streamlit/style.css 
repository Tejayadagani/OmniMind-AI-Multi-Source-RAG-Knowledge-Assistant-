/* Premium buttons */
div.stButton > button {
    background-color: #4CAF50;
    color: white;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: bold;
}
div.stButton > button:hover {
    background-color: #45a049;
}

/* Chat bubbles */
.user-bubble {
    background-color: #2196F3;
    color: white;
    padding: 10px;
    border-radius: 10px;
    margin: 5px;
}
.assistant-bubble {
    background-color: #4CAF50;
    color: white;
    padding: 10px;
    border-radius: 10px;
    margin: 5px;
}

/* Sidebar cards */
.sidebar-card {
    padding: 15px;
    background-color: #2E2E2E;
    border-radius: 10px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.3);
    margin-bottom: 10px;
}
